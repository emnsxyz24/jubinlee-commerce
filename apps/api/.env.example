# Backend API Environment Variables

# Database Connection (Supabase / PostgreSQL - Pooled + Direct connection)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Application Server Port
PORT=3000

# Environment Mode (development / production)
NODE_ENV=development

# Swagger API Documentation (Disabled in production unless set to true)
ENABLE_SWAGGER=false

# JWT Secret Keys (Generate strong 32+ chars random string in production, e.g. `openssl rand -base64 32`)
# WARNING: The server will refuse to start in production if JWT_SECRET is missing!
JWT_SECRET=super_secret_jwt_key_change_in_production_12345
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production_67890

# Frontend URLs for CORS Authorization
STOREFRONT_URL=https://jubinlee.mikaeru.my.id
ADMIN_URL=http://localhost:3002

# Cloudinary Cloud Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Store WhatsApp Number (Fallback for checkout deep link)
STORE_WHATSAPP_NUMBER=6281234567890
